# Bu dosyayı .env.local olarak kopyala ve kendi Supabase bilgilerinle doldur.
#   cp .env.example .env.local
#
# Değerleri Supabase Dashboard → Project Settings → API sayfasından alabilirsin.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Storage'da görsellerin yüklendiği public bucket adı
NEXT_PUBLIC_BUCKET_NAME=documentspdfs

# Canlı site adresin (SEO/OG etiketleri ve RSS feed için kullanılır)
NEXT_PUBLIC_SITE_URL=https://stratejik-kutuphane.vercel.app

# --- E-posta aboneliği ve haftalık yedek (isteğe bağlı; README'de adım adım) ---
# Supabase → Project Settings → API → service_role (GİZLİ: yalnızca sunucuda)
SUPABASE_SERVICE_ROLE_KEY=
# resend.com → API Keys
RESEND_API_KEY=
MAIL_FROM=Zihin Haritası <bulten@zihinharitasi.org>
# Haftalık yedeğin gönderileceği adres
BACKUP_EMAIL=
# Vercel cron isteğini doğrulamak için uzun rastgele bir metin
CRON_SECRET=
